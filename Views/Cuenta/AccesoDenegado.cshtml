@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="container py-5 mt-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-5">
                    <!-- Icono de advertencia médica/seguridad -->
                    <h1 class="display-1 text-danger mb-4"></h1>

                    <h2 class="text-dark fw-bold mb-3">Acceso Restringido</h2>

                    <p class="text-muted fs-5 mb-4">
                        Lo sentimos, su rol actual (<strong>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</strong>) no tiene los permisos necesarios para acceder a esta área del sistema clínico.
                    </p>

                    <hr class="mb-4">

                    <p class="small text-secondary mb-4">
                        Si considera que esto es un error y necesita acceso a esta sección para sus labores en la clínica, por favor contacte al administrador del sistema.
                    </p>

                    <!-- Botón para regresar al inicio -->
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2 fw-bold">
                        ?? Regresar al panel principal
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>