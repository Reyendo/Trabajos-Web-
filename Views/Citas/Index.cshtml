@model IEnumerable<Practica02MediWebMVC.Models.Cita>
    @{
    ViewData["Title"] = "Citas Médicas";
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1>Citas Médicas</h1>
            <p class="text-muted mb-0">Registro general de citas programadas en la clínica.</p>
        </div>
        <!-- Botón de creación solo para Administradores y Recepcionistas (Equivalente a Capataz) -->
        @if (User.IsInRole("administrador") || User.IsInRole("recepcionista"))
    {
        <a asp-action="Create" class="btn btn-success">Nueva Cita</a>
    }
    </div>

    @if (TempData["Mensaje"] is not null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}
    @if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Fecha y Hora</th>
                    <th>Paciente</th>
                    <th>Médico</th>
                    <th>Consultorio</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
            {
                <tr>
                    <td>@item.FechaHora.ToString("dd/MM/yyyy hh:mm tt")</td>
                    <td>@item.PacienteNombre</td>
                    <td>@item.MedicoNombre</td>
                    <td>@item.ConsultorioNombre</td>
                    <td>
                        <!-- Indicador visual simple del estado -->
                        <span class="badge @(item.EstadoId == 1 ? "bg-primary" : item.EstadoId == 2 ? "bg-success" : "bg-danger")">
                            @item.EstadoNombre
                        </span>
                    </td>
                    <td class="text-nowrap">
                        <a asp-action="Details" asp-route-id="@item.CitaId" class="btn btn-sm btn-outline-secondary">Ver</a>

                        <!-- Edición solo para Administradores y Médicos (Equivalente a Veterinario) -->
                        @if (User.IsInRole("administrador") || User.IsInRole("medico"))
                        {
                        <a asp-action="Edit" asp-route-id="@item.CitaId" class="btn btn-sm btn-outline-primary">Editar</a>
                        }

                        <!-- Eliminación solo para Administradores -->
                        @if (User.IsInRole("administrador"))
                        {
                        <a asp-action="Delete" asp-route-id="@item.CitaId" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
